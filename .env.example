# ─ Common
NODE_ENV=development

# ─ API (NestJS)
API_PORT=4000
JWT_SECRET=change-me-to-a-random-32-byte-secret
JWT_EXPIRES_IN=3600
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000

# ─ DB (MySQL)
DB_HOST=db
DB_PORT=3306
DB_USER=board
DB_PASSWORD=board_pw
DB_NAME=board
MYSQL_ROOT_PASSWORD=root_pw

# ─ Web (Next.js)
# 브라우저는 same-origin 경로 /api/* 로만 호출하고, Next.js 서버가 rewrites 로
# 아래 타겟에 프록시한다.
#   - Docker Compose: http://api:4000 (compose.yml 의 web 서비스에서 주입)
#   - 로컬 dev:        http://localhost:4020 (override 포트)
API_PROXY_TARGET=http://api:4000

# ─ Harness: Slack (Phase 3)
# Bot token (xoxb-...). Slack App 생성 후 OAuth & Permissions 에서 발급.
# 필요 scopes: chat:write, channels:history, channels:read
SLACK_BOT_TOKEN=
# Coordinator 채널 ID (워크스페이스 URL 로 못 넣음 — Channel settings 에서 복사)
# 예: C0CAQV11UG3
SLACK_CHANNEL_ID=
