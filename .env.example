# ─ Common
NODE_ENV=development

# ─ API (NestJS)
API_PORT=4000
JWT_SECRET=change-me-to-a-random-32-byte-secret
JWT_EXPIRES_IN=3600
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000

# ─ DB (MySQL)
DB_HOST=db
DB_PORT=3306
DB_USER=board
DB_PASSWORD=board_pw
DB_NAME=board
MYSQL_ROOT_PASSWORD=root_pw

# ─ Web (Next.js)
NEXT_PUBLIC_API_BASE=/api
